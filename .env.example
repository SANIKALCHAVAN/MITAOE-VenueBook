# =========================================================
# MITAOE VenueBook - Supabase Production Environment Template
# =========================================================

# Client-Side Supabase Configuration (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-Side Supabase Configuration (Node.js / Express Backend)
# The Service Role Key is used SOLELY on the server for PRN mapping,
# role resolution, and atomic PostgreSQL RPC calls. NEVER expose it to the browser.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Backend Server Port (defaults to 5173 if running unified dev server)
PORT=5173
